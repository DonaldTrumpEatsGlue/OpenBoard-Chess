{
  "name": "openboard-chess",
  "private": true,
  "version": "1.0.0",
  "description": "A free, original chess game with local Stockfish opponents.",
  "author": "Openboard contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:custom-chess": "node scripts/test-custom-chess.mjs",
    "test:variant-engine": "node --test scripts/test-variant-engine-worker.test.mjs",
    "test:large-board": "node scripts/test-large-board-chess.mjs",
    "test:game-insights": "node --test scripts/test-game-insights.mjs",
    "test:sidebar-navigation": "node --test scripts/test-sidebar-navigation.test.mjs",
    "test:learning-content": "node --test scripts/test-learning-content.test.mjs",
    "test:academy-content": "node --test scripts/test-academy-content.test.mjs",
    "test:profile-utils": "node --test scripts/test-profile-utils.test.mjs",
    "test:online": "node --test server/test/*.test.js",
    "online-server": "node server/server.js",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.1",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "chess.js": "^0.10.3",
    "flag-icons": "^7.6.0",
    "stockfish": "^19.0.1",
    "ws": "^8.22.1"
  },
  "build": {
    "appId": "com.openboard.chess",
    "productName": "Openboard Chess",
    "icon": "assets/openboard.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "icon": "assets/openboard.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
